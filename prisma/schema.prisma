// This schema points at the same MongoDB database as the rewebetch.in
// website repo. Models mirror that repo's schema.prisma so the dashboard
// can read the same collections; a few dashboard-only fields (status,
// featured, notes) are added as optional so they don't collide with
// documents the website writes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  company   String?
  budget    String?
  timeline  String?
  subject   String?
  message   String
  status    String?  @default("new") // new, contacted, won, lost
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([status])
}

model Subscribe {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  status    String   @default("subscribed") // subscribed, unsubscribed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  visitorId     String       @unique
  firstSeenAt   DateTime     @default(now())
  lastSeenAt    DateTime     @default(now())
  visitsCount   Int          @default(1)
  lastUserAgent String?
  lastReferrer  String?
  events        VisitEvent[]

  @@index([lastSeenAt])
}

model VisitEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  visitorDbId String   @db.ObjectId
  path        String
  referrer    String?
  userAgent   String?
  ipAddress   String?
  visitedAt   DateTime @default(now())
  visitor     Visitor  @relation(fields: [visitorDbId], references: [id], onDelete: Cascade)

  @@index([visitorDbId])
  @@index([path])
  @@index([visitedAt])
}

model LaunchJoin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  whyJoin   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model ReviewRequest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  rating       Int
  review       String
  otpHash      String
  otpExpiresAt DateTime
  attempts     Int       @default(0)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String
  rating     Int
  review     String
  source     String   @default("website")
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  verifiedAt DateTime

  @@index([email])
  @@index([createdAt])
}
