# RewebTech API — OTP login + cookie session, aur saara dashboard data.
# Is app ka koi apna database connection nahi hai.
#
# Local dev me API bhi locally chalao (http://localhost:4000/api/v1). Prod API
# par point karke localhost se login nahi hoga: session cookie SameSite=Lax aur
# .rewebtech.in par scoped hai, toh browser use cross-site request par bhejta hi
# nahi. Dekho README ka "Local development".
NEXT_PUBLIC_API_URL=https://api.rewebtech.in/api/v1
